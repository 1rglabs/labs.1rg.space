---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = '1RG Labs' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    <link rel="canonical" href={canonical}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <div class="noise"></div>
    <div class="gradient-bg"></div>
    <div class="animated-grid-lines"></div>

    <slot />

    <div class="grid-overlay"></div>
    <div class="cursor-glow"></div>

    <script>
        const cursorGlow = document.querySelector<HTMLElement>('.cursor-glow')!;
        let mouseX = 0;
        let mouseY = 0;
        let currentX = 0;
        let currentY = 0;

        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        function animate() {
            currentX += (mouseX - currentX) * 0.1;
            currentY += (mouseY - currentY) * 0.1;

            cursorGlow.style.transform = `translate(${currentX}px, ${currentY}px)`;

            requestAnimationFrame(animate);
        }

        animate();

        // Fade out animated grid lines on scroll
        const animatedGridLines = document.querySelector<HTMLElement>('.animated-grid-lines')!;

        function handleScroll() {
            const scrollY = window.scrollY;
            const maxScroll = 300;
            const opacity = Math.max(0, 1 - (scrollY / maxScroll));

            animatedGridLines.style.opacity = String(opacity);
        }

        window.addEventListener('scroll', handleScroll, { passive: true });
    </script>
</body>
</html>
